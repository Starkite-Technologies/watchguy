generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EDITOR
  REVIEWER
}

enum AvailabilityStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum OwnershipType {
  COMPANY
  THIRD_PARTY
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  INFO_REQUESTED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum ContactMethod {
  WHATSAPP
  EMAIL
  PHONE
}

model AdminUser {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  password  String
  role      Role     @default(REVIEWER)
  createdAt DateTime @default(now())
}

model Seller {
  id                     String            @id @default(uuid()) @db.Uuid
  fullName               String
  email                  String
  phone                  String
  preferredContactMethod ContactMethod     @default(WHATSAPP)
  submissions            WatchSubmission[]
  watches                Watch[]
  createdAt              DateTime          @default(now())
}

model Watch {
  id              String             @id @default(uuid()) @db.Uuid
  slug            String             @unique
  brand           String
  model           String
  referenceNumber String?
  year            Int?
  condition       String
  description     String
  price           Decimal            @db.Decimal(14, 2)
  currency        String             @default("NAD")
  status          AvailabilityStatus @default(AVAILABLE)
  ownershipType   OwnershipType      @default(COMPANY)
  sellerId        String?            @db.Uuid
  seller          Seller?            @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  featured        Boolean            @default(false)
  published       Boolean            @default(true)
  diameter        String?
  movement        String?
  box             Boolean            @default(false)
  papers          Boolean            @default(false)
  submissionId    String?            @unique @db.Uuid
  submission      WatchSubmission?   @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  images          WatchImage[]
  enquiries       Enquiry[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([published, status, featured])
}

model WatchImage {
  id        String   @id @default(uuid()) @db.Uuid
  watchId   String   @db.Uuid
  watch     Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([watchId, sortOrder])
}

model WatchSubmission {
  id              String           @id @default(uuid()) @db.Uuid
  sellerId        String           @db.Uuid
  seller          Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  brand           String
  model           String
  referenceNumber String?
  year            Int?
  condition       String
  requestedPrice  Decimal          @db.Decimal(14, 2)
  currency        String           @default("NAD")
  description     String
  defects         String?
  box             Boolean          @default(false)
  papers          Boolean          @default(false)
  proof           Boolean          @default(false)
  status          SubmissionStatus @default(PENDING_REVIEW)
  reviewNotes     String?
  reviewedBy      String?          @db.Uuid
  reviewedAt      DateTime?
  emailSent       Boolean          @default(false)
  images          SubmissionImage[]
  approvedWatch   Watch?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, createdAt])
}

model SubmissionImage {
  id           String          @id @default(uuid()) @db.Uuid
  submissionId String          @db.Uuid
  submission   WatchSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  storageKey   String
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())

  @@index([submissionId, sortOrder])
}

model Enquiry {
  id            String        @id @default(uuid()) @db.Uuid
  watchId       String?       @db.Uuid
  watch         Watch?        @relation(fields: [watchId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String
  customerPhone String?
  message       String
  status        EnquiryStatus @default(NEW)
  emailSent     Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([status, createdAt])
}

model AdminActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  actorName String?
  action    String
  entityId  String
  detail    String?
  createdAt DateTime @default(now())

  @@index([entityId, createdAt])
}

model SiteContent {
  id        String   @id @default("home")
  content   Json
  updatedAt DateTime @updatedAt
}

model RateLimit {
  key         String   @id
  attempts    Int      @default(1)
  windowStart DateTime @default(now())
}
