generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("REVIEWER") // OWNER, EDITOR, REVIEWER
  createdAt DateTime @default(now())
}

model Seller {
  id                     String            @id @default(uuid())
  fullName               String
  email                  String
  phone                  String
  preferredContactMethod String            @default("WHATSAPP") // WHATSAPP, EMAIL, PHONE
  submissions            WatchSubmission[]
  watches                Watch[]
  createdAt              DateTime          @default(now())
}

model Watch {
  id              String           @id @default(uuid())
  slug            String           @unique
  brand           String
  model           String
  referenceNumber String?
  year            Int?
  condition       String
  description     String
  price           Int              // in cents / minor currency units (e.g. 15000000 = N$ 150,000.00)
  currency        String           @default("NAD")
  status          String           @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD
  ownershipType   String           @default("COMPANY") // COMPANY, THIRD_PARTY
  sellerId        String?
  seller          Seller?          @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  featured        Boolean          @default(false)
  published       Boolean          @default(true)
  diameter        String?
  movement        String?
  box             Boolean          @default(false)
  papers          Boolean          @default(false)
  submissionId    String?          @unique
  submission      WatchSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  images          WatchImage[]
  enquiries       Enquiry[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([published, status, featured])
}

model WatchImage {
  id        String   @id @default(uuid())
  watchId   String
  watch     Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([watchId, sortOrder])
}

model WatchSubmission {
  id              String            @id @default(uuid())
  sellerId        String
  seller          Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  brand           String
  model           String
  referenceNumber String?
  year            Int?
  condition       String
  requestedPrice  Int               // in cents (NAD)
  currency        String            @default("NAD")
  description     String
  defects         String?
  box             Boolean           @default(false)
  papers          Boolean           @default(false)
  proof           Boolean           @default(false)
  status          String            @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED, INFO_REQUESTED
  reviewNotes     String?
  reviewedBy      String?
  reviewedAt      DateTime?
  emailSent       Boolean           @default(false)
  images          SubmissionImage[]
  approvedWatch   Watch?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, createdAt])
}

model SubmissionImage {
  id           String          @id @default(uuid())
  submissionId String
  submission   WatchSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  storageKey   String
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())

  @@index([submissionId, sortOrder])
}

model Enquiry {
  id            String   @id @default(uuid())
  watchId       String?
  watch         Watch?   @relation(fields: [watchId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String
  customerPhone String?
  message       String
  status        String   @default("NEW") // NEW, CONTACTED, CLOSED
  emailSent     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([status, createdAt])
}

model AdminActivityLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorName String?
  action    String
  entityId  String
  detail    String?
  createdAt DateTime @default(now())

  @@index([entityId, createdAt])
}

model SiteContent {
  id        String   @id @default("home")
  content   String   // JSON payload
  updatedAt DateTime @updatedAt
}

model RateLimit {
  key         String   @id
  attempts    Int      @default(1)
  windowStart DateTime @default(now())
}
