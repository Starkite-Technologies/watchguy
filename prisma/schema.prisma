generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
enum Role {
 OWNER
 EDITOR
 REVIEWER
}
enum Availability {
 AVAILABLE
 RESERVED
 SOLD
 ARCHIVED
}
enum OwnershipType {
 STORE
 THIRD_PARTY
}
enum SubmissionStatus {
 PENDING_REVIEW
 INFO_REQUESTED
 APPROVED
 REJECTED
}
enum EnquiryStatus {
 NEW
 CONTACTED
 CLOSED
}
enum EmailStatus {
 PENDING
 SENDING
 SENT
 FAILED
}
model AdminUser {
 id String @id @db.Uuid
 email String @unique
 name String
 role Role @default(REVIEWER)
 createdAt DateTime @default(now())
 reviews WatchSubmission[]
 activity AdminActivityLog[]
}
model Seller {
 id String @id @default(uuid()) @db.Uuid
 fullName String
 email String
 phone String
 preferredContactMethod String
 createdAt DateTime @default(now())
 submissions WatchSubmission[]
 watches Watch[]
 @@index([email])
}
model Watch {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 brand String
 model String
 reference String? @map("referenceNumber")
 year Int?
 condition String
 description String
 defects String @default("")
 price Decimal @db.Decimal(14,2)
 currency String @default("NAD")
 availability Availability @default(AVAILABLE)
 sellerType OwnershipType @default(STORE) @map("ownershipType")
 sellerId String? @db.Uuid
 seller Seller? @relation(fields:[sellerId],references:[id],onDelete:Restrict)
 submissionId String? @unique @db.Uuid
 submission WatchSubmission? @relation(fields:[submissionId],references:[id],onDelete:Restrict)
 isDemo Boolean @default(false)
 published Boolean @default(false)
 featured Boolean @default(false)
 box Boolean @default(false)
 papers Boolean @default(false)
 diameter String?
 movement String?
 caseMaterial String?
 dial String?
 bracelet String?
 waterResistance String?
 writeUp String?
 seoTitle String?
 seoDescription String?
 images WatchImage[]
 enquiries Enquiry[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([published,availability,featured])
 @@index([brand,condition,price])
}
model WatchImage {
 id String @id @default(uuid()) @db.Uuid
 watchId String @db.Uuid
 watch Watch @relation(fields:[watchId],references:[id],onDelete:Cascade)
 imageUrl String
 sortOrder Int
 @@unique([watchId,sortOrder])
}
model WatchSubmission {
 id String @id @default(uuid()) @db.Uuid
 sellerId String @db.Uuid
 seller Seller @relation(fields:[sellerId],references:[id],onDelete:Restrict)
 brand String
 model String
 reference String?
 year Int?
 condition String
 requestedPrice Decimal @db.Decimal(14,2)
 currency String @default("NAD")
 description String
 defects String @default("")
 box Boolean @default(false)
 papers Boolean @default(false)
 consentAt DateTime @default(now())
 status SubmissionStatus @default(PENDING_REVIEW)
 reviewNotes String?
 reviewedById String? @db.Uuid
 reviewedBy AdminUser? @relation(fields:[reviewedById],references:[id],onDelete:Restrict)
 reviewedAt DateTime?
 images SubmissionImage[]
 watch Watch?
 emails EmailOutbox[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status,createdAt])
}
model SubmissionImage {
 id String @id @default(uuid()) @db.Uuid
 submissionId String @db.Uuid
 submission WatchSubmission @relation(fields:[submissionId],references:[id],onDelete:Cascade)
 storageKey String
 sortOrder Int
 @@unique([submissionId,sortOrder])
}
model Enquiry {
 id String @id @default(uuid()) @db.Uuid
 watchId String? @db.Uuid
 watch Watch? @relation(fields:[watchId],references:[id],onDelete:SetNull)
 name String @map("customerName")
 email String @map("customerEmail")
 phone String? @map("customerPhone")
 message String
 status EnquiryStatus @default(NEW)
 createdAt DateTime @default(now())
 @@index([status,createdAt])
}
model AdminActivityLog {
 id String @id @default(uuid()) @db.Uuid
 actorId String @db.Uuid
 actor AdminUser @relation(fields:[actorId],references:[id],onDelete:Restrict)
 action String
 entityId String
 detail String?
 createdAt DateTime @default(now())
 @@index([entityId,createdAt])
}
model EmailOutbox {
 id String @id @default(uuid()) @db.Uuid
 submissionId String? @db.Uuid
 submission WatchSubmission? @relation(fields:[submissionId],references:[id],onDelete:SetNull)
 to String
 subject String
 text String
 status EmailStatus @default(PENDING)
 attempts Int @default(0)
 nextAttempt DateTime @default(now())
 claimedAt DateTime?
 sentAt DateTime?
 lastError String?
 createdAt DateTime @default(now())
 @@index([status,nextAttempt])
}
model RateLimit {
 key String @id
 attempts Int @default(1)
 windowStart DateTime @default(now())
}
model SiteContent {
 id String @id @default("home")
 content Json
 updatedAt DateTime @updatedAt
}
