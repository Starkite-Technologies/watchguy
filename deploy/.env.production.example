# Copy to deploy/.env.production on the server and fill in. Never commit it.

# ---- Domain (Caddy) ----
SITE_DOMAIN=atelier.example.com

# ---- Public values: baked into the browser bundle at BUILD time ----
# Changing any NEXT_PUBLIC_ value requires: docker compose ... up -d --build
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# ---- Server secrets: read at RUNTIME only ----
APP_ORIGIN=https://atelier.example.com
# Supabase > Connect > Session pooler (port 5432). Keep sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=
DEMO_MODE=false

# Leave empty when the domain's DNS record is "DNS only" (grey cloud).
# Set to cf-connecting-ip ONLY if Cloudflare proxies the domain (orange cloud)
# AND the server firewall accepts 80/443 from Cloudflare IP ranges only.
TRUSTED_CLIENT_IP_HEADER=

# ---- Storage: Supabase Storage S3 endpoint (Storage > Settings > S3) ----
S3_REGION=YOUR-PROJECT-REGION
S3_ENDPOINT=https://YOUR-PROJECT.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=atelier-submissions
S3_PUBLIC_BUCKET=atelier-watches
S3_FORCE_PATH_STYLE=true
PUBLIC_ASSET_BASE_URL=https://YOUR-PROJECT.supabase.co/storage/v1/object/public/atelier-watches

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Atelier Timepieces <notifications@atelier.example.com>
ADMIN_EMAIL=owner@atelier.example.com
MAIL_FLUSH_INTERVAL_SECONDS=60

# ---- Bot protection (Cloudflare Turnstile) ----
TURNSTILE_SECRET_KEY=

REJECTED_RETENTION_DAYS=90
