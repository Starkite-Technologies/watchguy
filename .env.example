# ATELIER TIMEPIECES - Environment Configuration Template

# Database Connection
# Local development default uses SQLite file database:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL (Supabase / Neon / AWS RDS):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Application URL
APP_ORIGIN="http://localhost:3000"

# Security & Sessions
ADMIN_SESSION_SECRET="replace-with-a-secure-random-64-character-string-for-session-signing"
RATE_LIMIT_SECRET="replace-with-a-random-secret-for-ip-rate-limiting"

# Centralized Brand & Store Settings (Namibia)
NEXT_PUBLIC_BRAND_NAME="ATELIER TIMEPIECES"
NEXT_PUBLIC_BRAND_TAGLINE="Excellence in Swiss Horology"
NEXT_PUBLIC_LOCATION="Windhoek, Namibia"
NEXT_PUBLIC_CURRENCY="NAD"
NEXT_PUBLIC_CURRENCY_SYMBOL="N$"
NEXT_PUBLIC_WHATSAPP_NUMBER="+264812345678"

# Email & Notifications (Optional Resend integration)
RESEND_API_KEY=""
EMAIL_FROM="concierge@ateliertimepieces.com"
ADMIN_EMAIL="admin@ateliertimepieces.com"

# Object Storage (Optional for S3 / Cloudflare R2 / Supabase Storage)
# If empty, uploads are stored locally in public/uploads with authenticated streaming
STORAGE_PROVIDER="local"
# S3_BUCKET_NAME=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
