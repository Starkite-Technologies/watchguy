{
  "name": "atelier-timepieces",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 -p 3000",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "^8.16.0",
    "@supabase/supabase-js": "^2.0.0",
    "@supabase/ssr": "^0.7.0",
    "gsap": "3.15.1",
    "lucide-react": "^0.468.0",
    "zod": "4.6.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.65.0"
  }
}
